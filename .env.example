# Bu faylı `.env` adı ilə kopyala və açarlarından birini (və ya bir neçəsini)
# doldur. Heç biri olmasa da proqram işləyir — offline şablona düşür.
#
# Növbə (voice.py sırayla yoxlayır, biri bitəndə növbətisinə keçir):
#
#   GROQ_API_KEY    →  groq:openai/gpt-oss-120b
#                   →  groq:openai/gpt-oss-20b      (böyüyü bitəndə)
#   GOOGLE_API_KEY  →  gemini-2.0-flash             (Groq bitəndə)
#   OPENAI_API_KEY  →  gpt-4o-mini
#   ANTHROPIC_API_KEY → claude-sonnet-5
#   heç biri        →  offline şablon

GROQ_API_KEY=
GOOGLE_API_KEY=

# Model adlarını əvəz etmək üçün:
# EL_REGRESO_GROQ_MODEL=groq:openai/gpt-oss-20b
# EL_REGRESO_GEMINI_MODEL=google_genai:gemini-2.0-flash

# Bütün növbəni əl ilə vermək üçün (vergüllə, sıra ilə):
# EL_REGRESO_MODELS=google_genai:gemini-2.0-flash,groq:openai/gpt-oss-120b

# Node-ların gecikməsi (demo üçün): saniyə ilə
# EL_REGRESO_SLOW=0.4
